{
  "name": "ha-floorplan-3d",
  "version": "0.3.1",
  "description": "3D floorplan card for Home Assistant with built-in editor and entity hitboxes",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --format=esm --target=es2020 --outfile=floorplan_3d/www/floorplan-3d-card.js",
    "watch": "esbuild src/index.ts --bundle --format=esm --target=es2020 --outfile=floorplan_3d/www/floorplan-3d-card.js --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "three": "^0.180.0"
  }
}
